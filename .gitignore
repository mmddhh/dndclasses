# Gradle
.gradle/
build/

# IDE
.idea/
*.iml

# Logs / crash reports
*.log
crash-reports/

# Local jars (pulled through Gradle / CurseMaven)
libs/

# Forge run directory: ignore everything except the AUI pages and the AUI debug config.
run/*
!run/apricity/
!run/config/
run/config/*
!run/config/apricityui-client.toml

# AUI external debugger credentials (never commit)
run/apricity/debug.json
